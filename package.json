{
  "name": "divido",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "mobile": "pnpm --filter mobile start",
    "mobile:ios": "pnpm --filter mobile ios",
    "mobile:android": "pnpm --filter mobile android",
    "mobile:lint": "pnpm --filter mobile lint",
    "mobile:lint:fix": "pnpm --filter mobile lint:fix",
    "mobile:format:check": "pnpm --filter mobile format:check",
    "mobile:format": "pnpm --filter mobile format",
    "mobile:typecheck": "pnpm --filter mobile typecheck",
    "mobile:test": "pnpm --filter mobile test",
    "mobile:build": "pnpm --filter mobile build",
    "api:dev": "cd apps/api && php artisan serve --port=6501",
    "api:test": "cd apps/api && ./vendor/bin/pest",
    "api:lint": "cd apps/api && ./vendor/bin/pint --test",
    "api:lint:fix": "cd apps/api && ./vendor/bin/pint",
    "lint": "pnpm mobile:lint && pnpm mobile:format:check && pnpm api:lint",
    "typecheck": "pnpm mobile:typecheck",
    "test": "pnpm mobile:test && pnpm api:test",
    "build": "pnpm mobile:build"
  },
  "packageManager": "pnpm@10.23.0"
}
